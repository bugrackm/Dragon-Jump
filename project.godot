; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dragon Jump"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icons/icon_512.png"
boot_splash/stretch_mode=4
boot_splash/bg_color=Color(0.24313726, 0.6431373, 0.9882353, 1)
boot_splash/image="res://assets/splash/splash.png"
boot_splash/minimum_display_time=1500

[autoload]

ScreenLayout="*res://scripts/ScreenLayout.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/ui/theme/dragon_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.6784314, 0.9019608, 1, 1)
textures/vram_compression/import_etc2_astc=true
